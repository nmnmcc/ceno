{
  "name": "@ceno/schema",
  "version": "0.3.0",
  "type": "module",
  "license": "Apache-2.0",
  "description": "Schema-aware, version-migrating document operations layered over @ceno/core — a type-safe CouchDB client built on Effect",
  "keywords": [
    "couchdb",
    "effect",
    "type-safe",
    "database",
    "schema",
    "migration"
  ],
  "homepage": "https://github.com/nmnmcc/ceno#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/nmnmcc/ceno.git",
    "directory": "packages/schema"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json"
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepack": "yarn build",
    "build": "yarn run -T tsdown"
  },
  "peerDependencies": {
    "@ceno/core": "workspace:^",
    "effect": "^4.0.0-beta.84"
  }
}
