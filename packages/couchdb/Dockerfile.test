FROM node:24-slim
WORKDIR /app

RUN corepack enable

COPY package.json yarn.lock .yarnrc.yml ./
COPY packages/core/package.json packages/core/
COPY packages/couchdb/package.json packages/couchdb/

RUN yarn install

COPY tsconfig.json tsconfig.base.json vitest.config.ts vitest.setup.ts ./
COPY packages/core/ packages/core/
COPY packages/couchdb/ packages/couchdb/

CMD ["yarn", "test"]
