{
  "name": "@ceno/couchdb",
  "version": "0.5.0",
  "type": "module",
  "license": "Apache-2.0",
  "description": "CouchDB HTTP implementation of @ceno/core services — a type-safe CouchDB client built on Effect",
  "keywords": [
    "couchdb",
    "effect",
    "type-safe",
    "database",
    "http"
  ],
  "homepage": "https://github.com/nmnmcc/ceno#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/nmnmcc/ceno.git",
    "directory": "packages/couchdb"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.mjs",
      "./Client": "./dist/Client.mjs",
      "./CouchDB": "./dist/CouchDB.mjs",
      "./Database": "./dist/Database.mjs",
      "./DesignDocument": "./dist/DesignDocument.mjs",
      "./Document": "./dist/Document.mjs",
      "./Errors": "./dist/Errors.mjs",
      "./LocalDocument": "./dist/LocalDocument.mjs",
      "./Server": "./dist/Server.mjs",
      "./package.json": "./package.json"
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./Client": "./src/Client.ts",
    "./CouchDB": "./src/CouchDB.ts",
    "./Database": "./src/Database.ts",
    "./DesignDocument": "./src/DesignDocument.ts",
    "./Document": "./src/Document.ts",
    "./Errors": "./src/Errors.ts",
    "./LocalDocument": "./src/LocalDocument.ts",
    "./Server": "./src/Server.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepack": "yarn build",
    "build": "yarn run -T tsdown",
    "test:docker": "docker compose -f docker-compose.test.yml up --build --abort-on-container-exit --exit-code-from tests && docker compose -f docker-compose.test.yml down -v"
  },
  "peerDependencies": {
    "@ceno/core": "workspace:^",
    "effect": "^4.0.0-beta.86"
  },
  "dependencies": {
    "@babel/generator": "^7.29.7",
    "@babel/parser": "^7.29.7",
    "@babel/traverse": "^7.29.7",
    "@babel/types": "^7.29.7"
  }
}
