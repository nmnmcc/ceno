{
  "name": "@ceno/couchdb",
  "version": "0.3.0",
  "type": "module",
  "license": "Apache-2.0",
  "description": "CouchDB HTTP implementation of @ceno/core services — a type-safe CouchDB client built on Effect",
  "keywords": [
    "couchdb",
    "effect",
    "type-safe",
    "database",
    "http"
  ],
  "homepage": "https://github.com/nmnmcc/ceno#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/nmnmcc/ceno.git",
    "directory": "packages/couchdb"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json"
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepack": "yarn build",
    "build": "yarn run -T tsdown",
    "test:docker": "docker compose -f docker-compose.test.yml up --build --abort-on-container-exit --exit-code-from tests && docker compose -f docker-compose.test.yml down -v"
  },
  "peerDependencies": {
    "@ceno/core": "workspace:^",
    "effect": "^4.0.0-beta.84"
  },
  "devDependencies": {
    "@ceno/schema": "workspace:^"
  }
}
