{
  "private": true,
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "packageManager": "yarn@4.17.0",
  "scripts": {
    "postinstall": "effect-tsgo patch",
    "build": "yarn workspaces foreach -At --no-private run build",
    "check": "tsc -b --noEmit",
    "format": "prettier -w .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@effect/language-service": "^0.86.2",
    "@effect/tsgo": "^0.14.6",
    "@effect/vitest": "^4.0.0-beta.86",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/babel__generator": "^7.27.0",
    "@types/babel__traverse": "^7.28.0",
    "@types/node": "24",
    "@typescript/native-preview": "^7.0.0-dev.20260618.1",
    "effect": "^4.0.0-beta.86",
    "prettier": "^3.8.4",
    "tsdown": "^0.22.3",
    "tsx": "^4.19.4",
    "typescript": "^6.0.3",
    "vitest": "^4.0.0"
  }
}
